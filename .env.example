# Copy to .env (gitignored) and fill in. Used by docker-compose for the
# otel-collector sidecar and the image tag.
#
# Splunk Observability Cloud — ingest realm + org access token (SECRET).
# The access token is an ORG ingest token, not the public RUM token that lives
# in static/index.html. On the VPS, reuse the token already configured for the
# host collector (/etc/otel/collector/splunk-otel-collector.conf).
SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=

# Image tag to run. Locally this is ignored by `build` (tagged :local).
# On the VPS set to a git SHA for a pinned deploy, or leave 'latest'.
IMAGE_TAG=latest
